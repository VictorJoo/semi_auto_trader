TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# korea_investment 또는 ls_securities 같은 식으로 선택합니다.
BROKER_PROVIDER=korea_investment

# 주문 환경입니다. live로 바꾸면 실주문이 나갈 수 있으므로 기본은 paper로 둡니다.
BROKER_ENV=paper

# 계좌 조회 환경입니다. 실투자 보유 종목만 보고 싶으면 live로 바꿉니다.
KIS_ACCOUNT_ENV=paper

# 한국투자증권 Open API 예시
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01

# 실계좌 조회용 키가 모의투자 키와 다르면 아래를 사용합니다.
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=
KIS_LIVE_ACCOUNT_PRODUCT_CODE=01
